#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
head=$(git rev-parse HEAD)
check=0
while read -r local_ref local_oid remote_ref remote_oid; do
    # Deleting a remote ref introduces no code.
    case "$local_oid" in
        *[!0]*) ;;
        *) continue ;;
    esac
    commit=$(git rev-parse "$local_oid^{commit}")
    if [ "$commit" != "$head" ]; then
        echo "Local gate: push only the checked-out commit; check out $local_ref first." >&2
        exit 1
    fi
    check=1
done
[ "$check" -eq 1 ] || exit 0
if [ -n "$(git status --porcelain --untracked-files=all)" ]; then
    echo "Local gate: commit or stash changes before pushing so coverage matches HEAD." >&2
    exit 1
fi
./scripts/check-local-gate.sh
if [ "$(git rev-parse HEAD)" != "$head" ] ||
    [ -n "$(git status --porcelain --untracked-files=all)" ]; then
    echo "Local gate: repository changed during validation; retry after committing changes." >&2
    exit 1
fi
